# Usage Proxy environment configuration
# Copy to .env and fill in real values.

# Port the proxy listens on
PORT=8787

# Centralized upstream API keys (server-side only, never sent to clients)
DEEPSEEK_API_KEY=sk-...
# Optional override for the upstream base URL (defaults to api.deepseek.com)
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# Upstream request timeout in milliseconds (default 60000)
# DEEPSEEK_TIMEOUT_MS=60000

# Addis AI (translation)
ADDIS_API_KEY=sk_...
# Optional override for the upstream base URL (defaults to api.addisassistant.com)
# ADDIS_BASE_URL=https://api.addisassistant.com
# Upstream request timeout in milliseconds (default 60000)
# ADDIS_TIMEOUT_MS=60000

# Minimum ledger balance before a customer is rejected with 402 (default 0)
# MIN_BALANCE_THRESHOLD=0

# Initial top-up balance for a freshly seeded test customer (default 5.00)
# SEED_BALANCE=5.00

# Postgres connection string
DATABASE_URL=postgresql://nate@127.0.0.1:5433/usage_proxy

# Optional seed overrides
# SEED_CUSTOMER_NAME=Test Customer
# SEED_CUSTOMER_EMAIL=test@example.com
# SEED_INSTANCE_LABEL=Test Instance
